<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical" android:background="@drawable/widget_card">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <TextView android:id="@+id/widget_category" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="AMOR" android:textColor="#DAB270" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
  <TextView android:id="@+id/widget_change" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:text="•••" android:textColor="#DAB270" android:textSize="17sp" android:background="@drawable/widget_action"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="❤️ Nosso relacionamento" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="2"/>
 <TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="3 anos • 120 dias" android:textColor="#E8C895" android:textSize="20sp" android:textStyle="bold" android:maxLines="2"/>
 <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="DESDE 02 SET 2023" android:textColor="#B8C0CC" android:textSize="10sp" android:letterSpacing="0.06"/>
</LinearLayout>
